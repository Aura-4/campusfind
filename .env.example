# ─────────────────────────────────────────────────────────────
# HKBK Lost & Found Portal — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:8000

# Image storage provider: "local" | "cloudinary" | "s3"
# Keep as "local" until backend storage is finalized
VITE_IMAGE_STORAGE_PROVIDER=local

# Cloudinary (required only when VITE_IMAGE_STORAGE_PROVIDER=cloudinary)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# AWS S3 (required only when VITE_IMAGE_STORAGE_PROVIDER=s3)
VITE_S3_BUCKET=
VITE_S3_REGION=
